package main

import "sys/os"

// Ackermann(3, 5) with an explicit stack, 42,438 steps, once per round. The
// loop variant of ackermann, which the CX forms run instead of the recursive
// one (decision D145).

// benchSize is the number of rounds, the first argument.
var benchSize i32

// benchZero is 0, the second argument, which no compiler sees at build time,
// so none precomputes a round, see README.md.
var benchZero i32

func fnv(h ui64, v ui64) (out ui64) {
	out = (h ^ v) * 1099511628211UL
}

// ackermann takes one step per call of the recursive form: pop m, then push
// what the call would recurse into. A(3, 5) holds at most 252 pending m values.
func ackermann(m i32, n i32) (out i32) {
	var stack [1024]i32
	var top i32 = 1
	stack[0] = m
	for top > 0 {
		top--
		m = stack[top]
		if m == 0 {
			n++
		} else if n == 0 {
			stack[top] = m - 1
			top++
			n = 1
		} else {
			stack[top] = m - 1
			stack[top+1] = m
			top = top + 2
			n--
		}
	}
	out = n
}

func run(size i32) (h ui64, ok bool) {
	global benchZero
	h = 14695981039346656037UL
	ok = true
	var r i32
	var round i32
	for round = 0; round < size; round++ {
		r = ackermann(3, 5+benchZero)
		h = fnv(h, i32.ui64(r))
		ok = ok && r == 253
	}
}

// benchArg returns argument index as a decimal i32, read when the program
// runs as the other languages read it.
func benchArg(index i32) (value i32) {
	var argument [16]ui8
	var length i32 = os.ArgRead(index, argument)
	var digit i32
	for digit = 0; digit < length; digit++ {
		value = value*10 + ui8.i32(argument[digit]) - 48
	}
}

func main() {
	global benchSize, benchZero
	benchSize = benchArg(0)
	benchZero = benchArg(1)
	var h1 ui64
	var h2 ui64
	var ok1 bool
	var ok2 bool
	h1, ok1 = run(benchSize)
	h2, ok2 = run(benchSize)
	ui64.print(h1)
	if ok1 && ok2 && h1 == h2 {
		printf("ackermanniter pass\n")
	} else {
		printf("ackermanniter FAIL\n")
	}
}
