package main

import "sys/os"

// Recursive fib(25), 242,785 calls, once per round.

// benchSize is the number of rounds, the first argument.
var benchSize i32

// benchZero is 0, the second argument, which no compiler sees at build time,
// so none precomputes a round, see README.md.
var benchZero i32

func fnv(h ui64, v ui64) (out ui64) {
	out = (h ^ v) * 1099511628211UL
}

func fib(n i32) (out i32) {
	if n < 2 {
		out = n
	} else {
		out = fib(n-1) + fib(n-2)
	}
}

func run(size i32) (h ui64, ok bool) {
	global benchZero
	h = 14695981039346656037UL
	ok = true
	var r i32
	var round i32
	for round = 0; round < size; round++ {
		r = fib(25 + benchZero)
		h = fnv(h, i32.ui64(r))
		ok = ok && r == 75025
	}
}

// benchArg returns argument index as a decimal i32, read when the program
// runs as the other languages read it.
func benchArg(index i32) (value i32) {
	var argument [16]ui8
	var length i32 = os.ArgRead(index, argument)
	var digit i32
	for digit = 0; digit < length; digit++ {
		value = value*10 + ui8.i32(argument[digit]) - 48
	}
}

func main() {
	global benchSize, benchZero
	benchSize = benchArg(0)
	benchZero = benchArg(1)
	var h1 ui64
	var h2 ui64
	var ok1 bool
	var ok2 bool
	h1, ok1 = run(benchSize)
	h2, ok2 = run(benchSize)
	ui64.print(h1)
	if ok1 && ok2 && h1 == h2 {
		printf("fib pass\n")
	} else {
		printf("fib FAIL\n")
	}
}
