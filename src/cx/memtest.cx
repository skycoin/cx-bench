package main

import "sys/os"

// A memtest86 style test of a 4 MiB ui32 array once per round: address in
// address, walking ones over the first 64 Ki words and moving inversions with
// four patterns. Each test hashes its mismatch count and the sum it read.

// benchSize is the number of rounds, the first argument.
var benchSize i32

func fnv(h ui64, v ui64) (out ui64) {
	out = (h ^ v) * 1099511628211UL
}

var mem [1048576]ui32

func run(size i32) (h ui64, ok bool) {
	global mem
	h = 14695981039346656037UL
	var n i32
	n = 1048576
	var walk i32
	walk = 65536
	var i i32
	var bad i32
	var total i32
	var read ui32
	var sum ui64
	var all ui32
	all = 4294967295U
	var bit ui32
	var pattern ui32
	var patterns [4]ui32
	patterns[0] = 0U
	patterns[1] = 4294967295U
	patterns[2] = 1431655765U
	patterns[3] = 2863311530U
	var k i32
	var inverse ui32
	total = 0
	var round i32
	for round = 0; round < size; round++ {
		bad = 0
		sum = 0UL
		for i = 0; i < n; i++ {
			mem[i] = i32.ui32(i)
		}
		for i = 0; i < n; i++ {
			read = mem[i]
			if read != i32.ui32(i) {
				bad++
			}
			sum = sum + ui32.ui64(read)
		}
		for i = 0; i < n; i++ {
			mem[i] = i32.ui32(i) ^ all
		}
		for i = 0; i < n; i++ {
			read = mem[i]
			if read != (i32.ui32(i) ^ all) {
				bad++
			}
			sum = sum + ui32.ui64(read)
		}
		h = fnv(h, i32.ui64(bad))
		h = fnv(h, sum)
		total = total + bad
		for bit = 0U; bit < 32U; bit++ {
			pattern = 1U << bit
			bad = 0
			sum = 0UL
			for i = 0; i < walk; i++ {
				mem[i] = pattern
			}
			for i = 0; i < walk; i++ {
				read = mem[i]
				if read != pattern {
					bad++
				}
				sum = sum + ui32.ui64(read)
			}
			h = fnv(h, i32.ui64(bad))
			h = fnv(h, sum)
			total = total + bad
		}
		for k = 0; k < 4; k++ {
			pattern = patterns[k]
			inverse = pattern ^ all
			bad = 0
			sum = 0UL
			for i = 0; i < n; i++ {
				mem[i] = pattern
			}
			for i = 0; i < n; i++ {
				read = mem[i]
				if read != pattern {
					bad++
				}
				sum = sum + ui32.ui64(read)
				mem[i] = inverse
			}
			for i = n - 1; i >= 0; i-- {
				read = mem[i]
				if read != inverse {
					bad++
				}
				sum = sum + ui32.ui64(read)
				mem[i] = pattern
			}
			for i = 0; i < n; i++ {
				read = mem[i]
				if read != pattern {
					bad++
				}
				sum = sum + ui32.ui64(read)
			}
			h = fnv(h, i32.ui64(bad))
			h = fnv(h, sum)
			total = total + bad
		}
	}
	ok = total == 0
}

// benchArg returns argument index as a decimal i32, read when the program
// runs as the other languages read it.
func benchArg(index i32) (value i32) {
	var argument [16]ui8
	var length i32 = os.ArgRead(index, argument)
	var digit i32
	for digit = 0; digit < length; digit++ {
		value = value*10 + ui8.i32(argument[digit]) - 48
	}
}

func main() {
	global benchSize
	benchSize = benchArg(0)
	var h1 ui64
	var h2 ui64
	var ok1 bool
	var ok2 bool
	h1, ok1 = run(benchSize)
	h2, ok2 = run(benchSize)
	ui64.print(h1)
	if ok1 && ok2 && h1 == h2 {
		printf("memtest pass\n")
	} else {
		printf("memtest FAIL\n")
	}
}
